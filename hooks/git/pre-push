#!/usr/bin/env bash
# Pushing main must raise VERSION past the remote's, so two machines never
# publish different code under one number.
updates="$(cat)"
printf '%s\n' "$updates" | "$(dirname "$0")/run-previous-hook" pre-push "$@" || exit $?
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
checker="$root/ui/release_version.py"
[ -f "$checker" ] || exit 0
printf '%s\n' "$updates" | python3 "$checker" pre-push "$@"
