#!/usr/bin/env bash
# Delegate to the core.hooksPath that was active before Orc was installed.
hook_name="$1"
shift
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
previous="$(git -C "$root" config orc.previousHooksPath 2>/dev/null || true)"
[ -n "$previous" ] && [ "$previous" != "__unset__" ] || exit 0
case "$previous" in
  /*) hook="$previous/$hook_name" ;;
  *)  hook="$root/$previous/$hook_name" ;;
esac
[ -x "$hook" ] || exit 0
exec "$hook" "$@"
