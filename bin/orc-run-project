#!/usr/bin/env python3
import argparse
import fcntl
import json
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'ui'))
import run_lifecycle


def correct_project(run_dir, repo):
    run_dir = Path(run_dir).expanduser().resolve(strict=True)
    target = Path(repo).expanduser().resolve(strict=True)
    config = json.loads((run_dir.parent.parent / 'config.json').read_text())
    configured = {Path(key).expanduser().resolve() for key in config.get('repos', {})}
    if target not in configured:
        raise ValueError('target must be a configured Orc project')
    result = subprocess.run(['git', '-C', str(target), 'rev-parse', '--show-toplevel'],
                            capture_output=True, text=True, check=True)
    if Path(result.stdout.strip()).resolve() != target:
        raise ValueError('target must be the project Git root')
    common = subprocess.run(['git', '-C', str(target), 'rev-parse', '--git-common-dir'],
                            capture_output=True, text=True, check=True)
    if (target / common.stdout.strip()).resolve() != (target / '.git').resolve():
        raise ValueError('target must be the original repository, not a worktree')
    with (run_dir / '.orc-phase-handoff.lock').open('a+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = run_dir / 'meta.json'
        meta = run_lifecycle.Snapshot(json.loads(path.read_text()))
        if meta.get('status') not in {'running', 'awaiting-gate', 'escalated'}:
            raise ValueError('only an active run can change projects')
        if meta.get('outcome') or meta.get('route') == 'orchestration-worker':
            raise ValueError('this run cannot change projects')
        if (meta.get('mainRepoPath') == str(target)
                and meta.get('repoPath') == str(target)):
            return {'runId': run_dir.name, 'mainRepoPath': str(target), 'changed': False}
        if meta.get('phase') not in {'grilling', 'clarification', 'plan'}:
            raise ValueError('project correction must happen before Build; start a context child in the target project')
        if any(meta.get(key) for key in (
                'branch', 'worktree', 'buildBaseCommit', 'repositories',
                'parentBranch', 'baseCommit', 'gitProvenance', 'forkFile',
                'orchestrationWorker')):
            raise ValueError('run already has repository authority; start a context child in the target project')
        if any((run_dir / name).exists() for name in (
                'inputs/build-spec', 'inputs/launch-delivery.json', 'plan-review',
                'delivery-authority.json', 'verification-receipt.json', 'diff.patch')):
            raise ValueError('run already has frozen or delivery authority; start a context child in the target project')
        dispatch = meta.get('phaseDispatch') or {}
        if dispatch.get('phases'):
            raise ValueError('run has phase dispatches; finish or cancel them before changing projects')
        meta.update(mainRepoPath=str(target), repoPath=str(target))
        run_lifecycle.write_meta(path, meta, caller='orc-run-project')
    return {'runId': run_dir.name, 'mainRepoPath': str(target), 'changed': True}


def main():
    parser = argparse.ArgumentParser(description='Correct an active run project before Build authority is frozen.')
    parser.add_argument('--run-dir', required=True)
    parser.add_argument('--repo', required=True)
    args = parser.parse_args()
    try:
        result = correct_project(args.run_dir, args.repo)
    except (OSError, ValueError, TypeError, subprocess.SubprocessError) as error:
        print('ERROR: ' + str(error), file=sys.stderr)
        return 1
    print(json.dumps(result))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
