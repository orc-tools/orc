#!/usr/bin/env python3
"""Finish a plan run: check its plan, mark it complete and open its gate.

    orc-plan-ready --run-dir <run-dir> [--title "<title>"] [--check]

A plan run (skills/orc-plan/SKILL.md) writes planning/planning.mdx and stops
for the user to read it. This is the one command that makes that stop. It
refuses a plan that is missing a part, runs past one screen, or names a
picture that is not in the run folder (ui/plan_check.py), and prints each
reason. Otherwise it sets planning.state to "complete" and opens the planning
gate, so the plan page offers Start work. `--check` only checks.
"""

import argparse
import contextlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "ui"))
import plan_check  # noqa: E402

SOURCE = "planning/planning.mdx"
QUESTIONS = "planning-questions.json"
ROUTE = "planning-session"


def write_meta(meta_path, meta):
    fd, temp_name = tempfile.mkstemp(prefix=".meta.json.", suffix=".tmp", dir=meta_path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(meta, handle, indent=2)
            handle.write("\n")
        os.replace(temp_name, meta_path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(temp_name)
        raise


def main():
    parser = argparse.ArgumentParser(prog="orc-plan-ready")
    parser.add_argument("--run-dir", required=True)
    parser.add_argument("--title", help="the run's title, at most 80 characters")
    parser.add_argument("--check", action="store_true",
                        help="check the plan and change nothing")
    args = parser.parse_args()
    run_dir = Path(args.run_dir).expanduser().resolve()
    meta_path = run_dir / "meta.json"
    try:
        meta = json.loads(meta_path.read_text())
        text = (run_dir / SOURCE).read_text(encoding="utf-8")
    except (OSError, ValueError) as exc:
        print("orc-plan-ready: %s" % exc, file=sys.stderr)
        return 2
    if not isinstance(meta, dict) or meta.get("route") != ROUTE:
        print("orc-plan-ready: %s is not a plan run" % run_dir.name, file=sys.stderr)
        return 2
    if meta.get("outcome") or meta.get("status") == "cancelled":
        print("orc-plan-ready: %s is closed" % run_dir.name, file=sys.stderr)
        return 2
    problems = plan_check.check(text, run_dir)
    if problems:
        print("orc-plan-ready: the plan is not ready to read:", file=sys.stderr)
        for problem in problems:
            print("  - " + problem, file=sys.stderr)
        return 1
    if args.check:
        print(json.dumps({"ok": True, "words": plan_check.words(text)}))
        return 0
    planning = meta.get("planning") if isinstance(meta.get("planning"), dict) else {}
    meta["planning"] = {**planning, "state": "complete", "round": planning.get("round", 0)}
    write_meta(meta_path, meta)
    # A round that was asked is answered by now, and its form goes with it.
    with contextlib.suppress(OSError):
        (run_dir / QUESTIONS).unlink()
    run_id = str(meta.get("runId") or run_dir.name)
    command = [str(ROOT / "bin" / "orc-ui"), "open", "--gate", "%s/planning/planning.html" % run_id]
    if args.title:
        command += ["--title", args.title]
    opened = subprocess.run(command, capture_output=True, text=True, check=False)
    combined = (opened.stdout + "\n" + opened.stderr).strip()
    status = json.loads(meta_path.read_text()).get("status")
    if opened.returncode != 0 or status != "awaiting-gate":
        print("orc-plan-ready: the plan gate did not open: %s"
              % (combined or "status=%s" % status), file=sys.stderr)
        return opened.returncode or 1
    port = os.environ.get("ORC_UI_PORT") or os.environ.get("ORC_UI_DEFAULT_PORT") or "4173"
    print(json.dumps({"ok": True, "words": plan_check.words(text), "status": status,
                      "gateUrl": "http://127.0.0.1:%s/#%s/planning/planning.html" % (port, run_id)}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
