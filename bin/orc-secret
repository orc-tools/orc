#!/usr/bin/env python3
"""Ask the user for a secret without it passing through the agent.

`orc-secret request NAME --reason "..."` shows a password field in the run's
Chat. Orc tells the agent the name once the local credential store has it.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ui"))

import keychain_secrets  # noqa: E402

STORE = "Windows credential store" if keychain_secrets.windows_host.WSL else "Keychain"
FINISHED = {"merged", "merged-to-parent", "complete", "cancelled"}


def read_value(args):
    value = keychain_secrets.read(args.name)
    if value is None:
        raise SystemExit(1)
    sys.stdout.write(value)


def run_dir_for(args):
    if args.run_dir:
        return Path(args.run_dir).expanduser()
    run_id = args.run_id or os.environ.get("ORC_RUN_ID")
    if not run_id:
        raise SystemExit("orc-secret: pass --run-dir or --run-id (ORC_RUN_ID is not set)")
    return Path(os.environ.get("ORC_RUNS_DIR") or Path.home() / ".orc" / "runs") / run_id


def request(args):
    run_dir = run_dir_for(args)
    try:
        status = json.loads((run_dir / "meta.json").read_text()).get("status")
    except (OSError, ValueError):
        raise SystemExit("orc-secret: %s is not a run directory" % run_dir)
    if status in FINISHED:
        raise SystemExit("orc-secret: run is %s and cannot ask for a secret" % status)
    present = keychain_secrets.exists(args.name)
    if present and not args.replace:
        command = keychain_secrets.read_command(args.name)
        print(f"{args.name} is already in the {STORE}. Read it inside the command that needs it: "
              f"$({command}). Pass --replace to ask the user for a new value.")
        return
    keychain_secrets.request(str(run_dir), args.name, args.reason, replaces=present)
    print("Asked for secret %s. Orc shows a password field in this run's Chat. End your "
          "turn now and tell the user what the secret is for; Orc sends a message when "
          "it is saved. Never ask the user to paste it into the chat." % args.name)


def check(args):
    if not keychain_secrets.exists(args.name):
        print(f"{args.name} is not in the {STORE}.")
        raise SystemExit(1)
    print(f"{args.name} is in the {STORE}. Read it with: {keychain_secrets.read_command(args.name)}")


def name(value):
    try:
        return keychain_secrets.validate_name(value)
    except keychain_secrets.SecretError as error:
        raise argparse.ArgumentTypeError(str(error))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    ask = commands.add_parser("request", help="ask the user to enter a secret in Orc")
    ask.add_argument("name", type=name, help="Credential name, such as STRIPE_API_KEY")
    ask.add_argument("--reason", default="", help="one line telling the user what it is for")
    ask.add_argument("--replace", action="store_true", help="ask even when the credential store has it")
    ask.add_argument("--run-dir")
    ask.add_argument("--run-id")
    ask.set_defaults(handler=request)
    look = commands.add_parser("check", help="exit 0 when the credential store has the secret")
    look.add_argument("name", type=name)
    look.set_defaults(handler=check)
    read = commands.add_parser("read", help="read a saved credential for use inside a command")
    read.add_argument("name", type=name)
    read.set_defaults(handler=read_value)
    args = parser.parse_args()
    try:
        args.handler(args)
    except keychain_secrets.SecretError as error:
        raise SystemExit("orc-secret: %s" % error)


if __name__ == "__main__":
    main()
