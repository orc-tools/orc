#!/usr/bin/env python3
"""Delegate read-only cross-harness tasks for an explicitly opted-in Orc run."""
import argparse
import json
import math
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def request(method, run_id, payload=None):
    port = int(os.environ.get('ORC_UI_PORT') or 4173)
    prefix = '/api/runs/' if method == 'GET' else '/runs/'
    url = 'http://127.0.0.1:%d%s%s/tasks' % (
        port, prefix, urllib.parse.quote(run_id, safe=''))
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=120) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as exc:
        try:
            detail = json.loads(exc.read()).get('error', str(exc))
        except (ValueError, AttributeError):
            detail = str(exc)
        raise ValueError(detail) from exc
    except urllib.error.URLError as exc:
        raise ValueError('Orc UI is unavailable: %s' % exc.reason) from exc


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('enable', 'disable', 'status', 'delegate', 'wait', 'cancel'):
        command = sub.add_parser(name)
        command.add_argument('run_id')
        if name in ('wait', 'cancel'):
            command.add_argument('task_id')
        if name == 'wait':
            command.add_argument('--timeout', type=float, default=30)
        if name == 'delegate':
            command.add_argument('--request-id', required=True,
                                 help='Stable caller ID; reuse it when retrying the same task')
            command.add_argument('--agent', default='auto',
                                 help='auto, codex, claude, or a discovered account such as claude-two')
            command.add_argument('--kind', choices=('research', 'review'), default='research')
            command.add_argument('--model')
            command.add_argument('--effort', help='Child effort; defaults to medium when omitted')
            command.add_argument('--project')
            command.add_argument('--text', required=True)
    args = parser.parse_args(argv)
    try:
        if args.command in ('enable', 'disable'):
            body = request('POST', args.run_id, {
                'action': 'configure', 'enabled': args.command == 'enable'})
        elif args.command == 'delegate':
            payload = {'action': 'delegate', 'requestId': args.request_id,
                       'text': args.text, 'kind': args.kind, 'agent': args.agent}
            if args.model:
                payload['model'] = args.model
            if args.effort is not None:
                payload['effort'] = args.effort
            if args.project:
                payload['project'] = args.project
            body = request('POST', args.run_id, payload)
        elif args.command == 'cancel':
            body = request('POST', args.run_id, {'action': 'cancel', 'taskId': args.task_id})
        elif args.command == 'wait':
            if not math.isfinite(args.timeout) or args.timeout < 0 or args.timeout > 300:
                raise ValueError('timeout must be between 0 and 300 seconds')
            deadline = time.monotonic() + args.timeout
            while True:
                body = request('GET', args.run_id)
                task = next((row for row in body['tasks'] if row['taskId'] == args.task_id), None)
                if task is None:
                    raise ValueError('task not found')
                if task['state'] in ('completed', 'failed', 'cancelled'):
                    body = {'task': task, 'timedOut': False}
                    break
                if time.monotonic() >= deadline:
                    body = {'task': task, 'timedOut': True}
                    break
                time.sleep(min(1, max(0, deadline - time.monotonic())))
        else:
            body = request('GET', args.run_id)
        print(json.dumps(body, indent=2))
        return 0
    except (ValueError, OSError) as exc:
        print('orc-task: %s' % exc, file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
