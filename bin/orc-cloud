#!/usr/bin/env python3
"""Point this machine at the Cloudflare Worker in cloud/project-memory,
which holds usage stats, version claims, vault sync and synced settings.

  orc-cloud configure --url https://orc-project-memory.<you>.workers.dev
      Save the Worker URL and make sure the Keychain holds the access token.
  orc-cloud status      Show whether a Worker is set up and what it reports.

A GitHub sign-in (Settings > Account) sets the Worker up without this.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ui"))

import cloud_worker  # noqa: E402
import keychain_secrets  # noqa: E402

CONFIG_DIR = Path(os.environ.get("ORC_HOME", "~/.orc")).expanduser()


def status():
    result = {"configured": cloud_worker.configured(CONFIG_DIR)}
    try:
        base, token = cloud_worker.credentials(CONFIG_DIR)
    except (cloud_worker.WorkerError, keychain_secrets.SecretError, OSError) as exc:
        result["error"] = str(exc)
        return result
    if base:
        result["url"] = base
        try:
            result["worker"] = cloud_worker.request(base, token, "GET", "/v1/health")
        except cloud_worker.WorkerError as exc:
            result["worker"] = {"ok": False, "error": str(exc)}
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    configure = commands.add_parser("configure")
    configure.add_argument("--url", required=True)
    commands.add_parser("status")
    args = parser.parse_args()
    try:
        if args.command == "configure":
            result = cloud_worker.configure(CONFIG_DIR, args.url)
        else:
            result = status()
    except (cloud_worker.WorkerError, keychain_secrets.SecretError) as exc:
        print(exc, file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2))
    return 0 if result.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
