#!/usr/bin/env python3
"""The guides to verifying changes that runs in a checkout follow, besides the
repository's own AGENTS.md or CLAUDE.md section.

`orc-verification-guides --repo <checkout>` prints a JSON list: the user's
private guide for the project first (kept in Orc's data, never committed),
then each enabled plugin's guide for the repository. Each row has `source`
(`private` or `plugin`) and `path`; plugin rows also name the `plugin`. The
checkout may be the main one or any of its worktrees.

`orc-verification-guides --repo <checkout> --private-path` prints where the
private guide for that project is saved, whether or not it exists yet: the
verification setup run writes it there when the user keeps the steps private.
"""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ui"))

from app_plugins import Registry  # noqa: E402
import project_verification  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    parser.add_argument("--repo", required=True, type=Path, help="a Git checkout or one of its worktrees")
    parser.add_argument("--private-path", action="store_true",
                        help="print where the private guide for this project is saved")
    args = parser.parse_args()
    if args.private_path:
        main_repo = project_verification.main_checkout(args.repo)
        if main_repo is None:
            parser.exit(1, "orc-verification-guides: %s is not a Git checkout\n" % args.repo)
        print(project_verification.private_guide_path(main_repo))
        return
    print(json.dumps(project_verification.guides(args.repo, Registry(Path.home()).verification_guides), indent=2))


if __name__ == "__main__":
    main()
