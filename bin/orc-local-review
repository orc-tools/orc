#!/usr/bin/env python3
"""Initialize, scope, publish, and close a single-pass read-only PR review."""

import argparse
import json
from pathlib import Path
import sys
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ui"))
import local_review


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    init = commands.add_parser("init")
    init.add_argument("--run-dir", type=Path)
    init.add_argument("--repo", type=Path, default=Path.cwd())
    init.add_argument("--harness", choices=("claude", "codex"), required=True)
    init.add_argument("--base")
    init.add_argument("--requirements-file", type=Path)
    init.add_argument("--ticket-file", type=Path, help="the ticket the PR implements")
    init.add_argument("--title")
    init.add_argument("--pr", help="the GitHub pull request URL under review")
    for name in ("scope", "publish", "close"):
        command = commands.add_parser(name)
        command.add_argument("--run-dir", type=Path, required=True)
        if name == "publish":
            command.add_argument("--input", type=Path, required=True)
        if name == "close":
            command.add_argument("--digest")
    args = parser.parse_args()
    try:
        if args.command == "init":
            run_dir = args.run_dir or Path.home() / ".orc/runs" / (
                "review-" + local_review.now().replace("-", "").replace(":", "")[:15]
                + "-" + uuid.uuid4().hex[:6])
            requirements = args.requirements_file.read_text() if args.requirements_file else None
            ticket = args.ticket_file.read_text() if args.ticket_file else None
            result = local_review.initialize(
                run_dir, args.repo, args.harness, args.base, requirements, args.title,
                ticket, args.pr)
            result = {"runDir": str(run_dir.resolve()), "meta": result}
        elif args.command == "scope":
            meta = local_review.active_meta(args.run_dir)
            result, _patches, _new = local_review.scope(meta["repoPath"], meta["review"]["baseRef"])
        elif args.command == "publish":
            result = local_review.publish(args.run_dir, json.loads(args.input.read_text()))
        else:
            result = local_review.close(args.run_dir, args.digest)
    except (local_review.ReviewError, OSError, ValueError) as exc:
        print("orc-local-review: " + str(exc), file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
