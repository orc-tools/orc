#!/usr/bin/env bash
# Compatibility entrypoint for older installed skills. Artifact copies are retired.
set -euo pipefail
if [ $# -ne 2 ]; then
  echo "usage: orc-snapshot <run-dir> <rel-file>" >&2
  exit 2
fi
case "/$2/" in
  //*|*/../*)
    echo "orc-snapshot: unsafe rel path: $2" >&2
    exit 2 ;;
esac
