#!/usr/bin/env python3
"""Hold a Ship-ready run until it is ready to deliver again.

A run parked at phase=ship,status=awaiting-gate shows Ready and offers its
delivery buttons. When a chat message at that stop reopens a decision, the
branch is no longer what the user would deliver, so control calls:

    orc-ship-hold --run-dir <run-dir> --reason '<what must change or be agreed>'

The run moves to status=escalated with a shipHold reason; phase stays ship.
Every delivery surface requires awaiting-gate, so no Merge or PR action
renders or is accepted while held, and the UI shows the reason as Not ready.
Re-running updates the reason. `orc-ui open --gate '<run-id>/pr-body.md'` (or
`ship/ship.html`) releases the hold once the change is finished and the
delivery authority is live again.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "ui"))
# The flock orc-ui's run_mutation_lock, orc-merge-main and orc-record-delivery
# take, so a hold never races a gate answer or a queued merge on the same repo.
from delivery_record import DeliveryError, meta_lock, now, read_meta, write_meta  # noqa: E402


MAX_REASON = 300
HOLDABLE_STATUSES = {"awaiting-gate", "running"}


class HoldError(Exception):
    pass


def hold(meta, reason):
    """Return True when meta changed."""
    route = meta.get("route")
    if route == "orchestration-worker":
        raise HoldError("the coordinator manages delivery for orchestration workers")
    if route == "local-review":
        raise HoldError("local reviews never deliver repository changes")
    if meta.get("lifecycleVersion") not in (3, 4):
        raise HoldError("only lifecycle v3 or v4 runs have a Ship stop")
    if meta.get("phase") != "ship":
        raise HoldError("run is at phase=%s; only a run at Ship can be held"
                        % meta.get("phase"))
    status = meta.get("status")
    existing = meta.get("shipHold")
    if status == "escalated" and isinstance(meta.get("mergeConflict"), dict):
        raise HoldError("run is blocked by merge conflicts; resolve them instead")
    if status == "escalated" and not isinstance(existing, dict):
        raise HoldError("run is escalated for another reason; it cannot be held")
    if status not in HOLDABLE_STATUSES and status != "escalated":
        raise HoldError("run is %s; only a run waiting at Ship can be held" % status)

    # Only a live hold keeps its heldAt; a stale record on a run that has
    # been ready or running since starts a new hold.
    if status == "escalated":
        held = {**existing, "reason": reason}
        if held == existing:
            return False
    else:
        held = {"reason": reason, "heldAt": now()}
    meta["status"] = "escalated"
    meta["shipHold"] = held
    return True


def main(argv=None):
    parser = argparse.ArgumentParser(prog="orc-ship-hold")
    parser.add_argument("--run-dir", required=True, type=pathlib.Path)
    parser.add_argument("--reason", required=True,
                        help="one line: what must change or be agreed")
    args = parser.parse_args(argv)

    reason = " ".join(args.reason.split())
    if not reason:
        parser.error("--reason must not be empty")
    if len(reason) > MAX_REASON:
        reason = reason[:MAX_REASON - 1].rstrip() + "\u2026"

    run_dir = args.run_dir.expanduser().resolve()
    meta_path = run_dir / "meta.json"
    try:
        with meta_lock(run_dir.parent, read_meta(meta_path)):
            meta = read_meta(meta_path)
            changed = hold(meta, reason)
            if changed:
                write_meta(meta_path, meta)
    except (HoldError, DeliveryError) as exc:
        print("orc-ship-hold: %s" % exc, file=sys.stderr)
        return 1

    print(json.dumps({
        "runId": meta.get("runId") or run_dir.name,
        "phase": meta["phase"],
        "status": meta["status"],
        "shipHold": meta["shipHold"],
        "changed": changed,
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
