#!/usr/bin/env python3
"""orc-record-model <run-dir> <phase> <role> <model> <source> — append one
subagent-model record to a run's meta.json (subagentModels[<phase>]).
See skills/_shared/handoff.md for the resolution ladder this feeds."""

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ui"))

from run_lifecycle import Snapshot, write_meta

SOURCES = {"self-report", "requested", "inherited"}


def main() -> int:
    if len(sys.argv) != 6:
        print("usage: orc-record-model <run-dir> <phase> <role> <model> <source>",
              file=sys.stderr)
        return 2

    run_dir, phase, role, model, source = sys.argv[1:]

    if not phase or not role or not model:
        print("orc-record-model: phase, role, and model must be non-empty",
              file=sys.stderr)
        return 1

    if source not in SOURCES:
        print(f"orc-record-model: source must be one of {sorted(SOURCES)}, got: {source}",
              file=sys.stderr)
        return 1

    meta_path = os.path.join(run_dir, "meta.json")
    try:
        with open(meta_path) as handle:
            value = json.load(handle)
        if not isinstance(value, dict):
            raise ValueError("expected a JSON object")
        meta = Snapshot(value)
    except (OSError, ValueError) as exc:
        print(f"orc-record-model: cannot read {meta_path}: {exc}", file=sys.stderr)
        return 1

    subagent_models = meta.setdefault("subagentModels", {})
    subagent_models.setdefault(phase, []).append(
        {"role": role, "model": model, "source": source})

    try:
        write_meta(meta_path, meta, caller="orc-record-model")
    except (OSError, ValueError) as exc:
        print(f"orc-record-model: {exc}", file=sys.stderr)
        return 1

    print(f"recorded: {phase}/{role} -> {model} ({source})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
