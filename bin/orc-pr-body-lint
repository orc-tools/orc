#!/usr/bin/env python3
"""Enforce the PR-body caps from skills/orc-docs without dependencies.

The caps only ever lived in skill prose, so a hand-authored `pr-body.md` that
skipped the docs phase shipped a write-up instead of a headline. This linter is
the mechanical guard: `/orc-docs pr` runs it before accepting a body and
`/orc-pr` runs it before pushing.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "ui"))
import project_settings
from project_settings import MAX_BODY_LINES, MAX_CONTEXT_WORDS, MAX_QA_STEPS, MIN_QA_STEPS
from project_setup import canonical_repo
from pr_body_edits import user_authored
from pr_body_images import (MARKDOWN_ANGLE_DEST, RAW_HTML_SCREENSHOT_TAG, image_identity,
                            image_sources, strip_code_and_comments, strip_fenced_code)


CONTEXT_HEADINGS = ("context",)
QA_HEADINGS = ("qa", "qa steps")
CHECKLIST_HEADINGS = ("checklist",)
# Everything from here on is template scaffolding, exempt from the body cap.
EXEMPT_FROM_BODY = CHECKLIST_HEADINGS + ("limitations", "screenshots", "ai contribution")

TEMPLATE_CANDIDATES = (
    ".github/pull_request_template.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
)
TEMPLATE_DIR = ".github/PULL_REQUEST_TEMPLATE"

AI_FOOTER = re.compile(
    r"(?:🤖\s*)?generated with \[?claude code|co-?authored-by:.*claude|"
    r"generated by (?:claude|an ai)",
    re.IGNORECASE,
)
# Orc's own review bookkeeping reported as a body line. Reviewers read it as bot
# chatter; the run's delivery authority and Orc UI already carry it.
REVIEW_STATUS = re.compile(
    r"^\s*(?:[-*]\s+)?(?:\*\*|_)?(?:self-review|self-recheck|independent review|code review)\b"
    r"[^.\n]{0,40}?\b(?:complete|clean|passed|done)\b",
    re.IGNORECASE,
)
# A per-file breakdown line: a bullet whose lead token is a path or a source
# file, followed by a description of what changed in it.
PER_FILE_BULLET = re.compile(
    r"^[-*]\s+`[^`]*(?:/|\.(?:rb|tsx?|jsx?|mjs|py|go|rs|css|scss|erb|json|ya?ml))[^`]*`"
)
PLACEHOLDER = re.compile(r"\b(?:TBD|TODO|FIXME)\b|\?{3,}", re.IGNORECASE)
SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+(?=[A-Z(`\"'\[])")
CHECKLIST_ITEM = re.compile(r"^([-*]\s+\[)[ xX](\]\s*)(.+)$")
LINK = re.compile(r"\[[^\]]+\]\([^)]+\)")
LOCAL_WORKTREE_HOST = re.compile(r"https?://(?:[\w.-]+\.localhost|localhost|127\.0\.0\.1)(?::\d+)?", re.IGNORECASE)
CANONICAL_HOST = "development host from the repository's configuration"
META_JSON_ANCESTOR_DEPTH = 4


def headings(lines: list[str]) -> list[tuple[str, int, int]]:
    """Return (normalized-title, start, end) for every `##`/`###` heading."""
    starts: list[tuple[str, int]] = []
    for index, line in enumerate(lines):
        match = re.match(r"^#{2,3}\s+(.+?)\s*$", line)
        if match:
            starts.append((match.group(1).strip().casefold(), index))
    return [
        (title, start, starts[position + 1][1] if position + 1 < len(starts) else len(lines))
        for position, (title, start) in enumerate(starts)
    ]


def section_body(lines: list[str], sections: list[tuple[str, int, int]], titles) -> list[str]:
    for title, start, end in sections:
        if title in titles:
            return [line for line in lines[start + 1:end] if line.strip()]
    return []


def find_template(repo: Path) -> Path | None:
    for candidate in TEMPLATE_CANDIDATES:
        path = repo / candidate
        if path.is_file():
            return path
    directory = repo / TEMPLATE_DIR
    if directory.is_dir():
        for path in sorted(directory.glob("*.md")):
            return path
    return None


def checklist_items(lines: list[str]) -> dict[str, str]:
    """Map normalized checklist text -> its raw text, keyed for comparison."""
    items: dict[str, str] = {}
    for line in lines:
        match = CHECKLIST_ITEM.match(line.strip())
        if match:
            text = match.group(3).strip()
            items[re.sub(r"\s+", " ", text).casefold()] = text
    return items


def explainer_lines(lines: list[str], sections: list[tuple[str, int, int]]) -> list[str]:
    """Return the Context section, or the headline's own section, minus scaffolding."""
    body = section_body(lines, sections, CONTEXT_HEADINGS)
    if not body and sections and lines[0].startswith("## "):
        title, start, end = sections[0]
        if title not in QA_HEADINGS + EXEMPT_FROM_BODY:
            body = lines[start + 1:end]
    text = re.sub(r"<!--.*?-->", "", "\n".join(body), flags=re.DOTALL)
    return [
        line.strip() for line in text.splitlines()
        if line.strip() and not LINK.fullmatch(line.strip())
        and not line.strip().casefold().startswith(("![", "<img", "<table", "|", "```"))
    ]


def check_context(body_lines: list[str], errors: list[str]) -> None:
    if not body_lines:
        errors.append("missing explainer line: add one sentence saying why the change was needed")
        return
    context = " ".join(body_lines)
    words = len(context.split())
    if words > MAX_CONTEXT_WORDS:
        errors.append(f"context {words} words > {MAX_CONTEXT_WORDS}")
    sentences = [part for part in SENTENCE_SPLIT.split(context.strip()) if part.strip()]
    if len(sentences) > 1:
        errors.append(f"context is {len(sentences)} sentences, must be 1")
    for line in body_lines:
        if PER_FILE_BULLET.match(line.strip()):
            errors.append(f'per-file breakdown line: "{line.strip()[:70]}"')


def check_qa(qa_lines: list[str], errors: list[str]) -> None:
    steps = [
        line for line in qa_lines
        if re.match(r"^(?:[-*]|\d+[.)])\s+\S", line.strip())
    ]
    if not steps:
        errors.append("no QA steps found")
        return
    if len(steps) > MAX_QA_STEPS:
        errors.append(f"{len(steps)} QA steps > {MAX_QA_STEPS}")
    if len(steps) < MIN_QA_STEPS:
        errors.append(f"{len(steps)} QA step(s) < {MIN_QA_STEPS}")


def check_body_budget(lines: list[str], sections: list[tuple[str, int, int]], errors: list[str]) -> None:
    exempt_from = len(lines)
    for title, start, _end in sections:
        if title in EXEMPT_FROM_BODY:
            exempt_from = min(exempt_from, start)
    counted = 0
    for line in lines[:exempt_from]:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        # Template intro tips (a bare link line) are exempt scaffolding.
        if LINK.fullmatch(stripped):
            continue
        counted += 1
    if counted > MAX_BODY_LINES:
        errors.append(f"body {counted} lines > {MAX_BODY_LINES} (excl. headings, checklist, screenshots)")


def find_run_dir(pr_body: Path) -> Path | None:
    """Find the run dir, the nearest ancestor holding meta.json.

    Bodies linted outside a run dir (e.g. straight from tests/fixtures) have
    no reachable meta.json — that's the normal case, not an error.
    """
    try:
        ancestors = list(pr_body.resolve().parents)
    except OSError:
        return None
    for ancestor in ancestors[:META_JSON_ANCESTOR_DEPTH]:
        if (ancestor / "meta.json").is_file():
            return ancestor
    return None


def read_run_json(pr_body: Path, name: str) -> dict | None:
    run_dir = find_run_dir(pr_body)
    if run_dir is None:
        return None
    try:
        data = json.loads((run_dir / name).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def find_meta_json(pr_body: Path) -> dict | None:
    return read_run_json(pr_body, "meta.json")


def check_deferred_findings(text: str, pr_body: Path, errors: list[str]) -> None:
    """Every review finding the run deferred, and every high or medium one
    control dismissed over its reviewer, must be disclosed to the reviewer."""
    authority = read_run_json(pr_body, "delivery-authority.json") or {}
    review = authority.get("reviewEvidence")
    review = review if isinstance(review, dict) else {}
    deferred = review.get("deferred") if isinstance(review.get("deferred"), list) else []
    closed = review.get("closedByControl") if isinstance(review.get("closedByControl"), list) else []
    dismissed = [finding for finding in closed if isinstance(finding, dict)
                 and finding.get("status") == "dismissed" and finding.get("severity") != "low"]
    for label, findings, detail in (("deferred", deferred, "its reason"),
                                    ("control-dismissed", dismissed, "why it was dismissed")):
        for finding in findings:
            identifier = finding.get("id") if isinstance(finding, dict) else None
            if isinstance(identifier, str) and identifier and identifier not in text:
                errors.append(
                    f'{label} review finding {identifier} ({finding.get("severity")}) is missing — '
                    f'list it under a Limitations heading with {detail}')


def check_worktree_host(text: str, pr_body: Path, errors: list[str]) -> None:
    leaked: set[str] = set()

    meta = find_meta_json(pr_body)
    worktree = meta.get("worktree") if meta else None
    if isinstance(worktree, dict):
        for value in (worktree.get("url"), worktree.get("baseDomain")):
            if isinstance(value, str) and value and value in text:
                leaked.add(value)

    for pattern in (LOCAL_WORKTREE_HOST,):
        leaked.update(match.group(0) for match in pattern.finditer(text))

    for host in sorted(leaked):
        errors.append(
            f'worktree host leaked in pr body: "{host}" — use the canonical {CANONICAL_HOST}'
        )


def check_template(text: str, lines: list[str], repo: Path | None, errors: list[str]) -> None:
    if repo is None:
        return
    template_path = find_template(repo)
    if template_path is None:
        return
    template_lines = template_path.read_text(encoding="utf-8").splitlines()
    template_items = checklist_items(template_lines)
    body_items = checklist_items(lines)
    for key, raw in template_items.items():
        if key not in body_items:
            errors.append(f'template checklist item reworded or dropped: "{raw[:70]}"')
    for line in template_lines:
        stripped = line.strip()
        if LINK.fullmatch(stripped) and stripped not in text:
            errors.append(f'template intro tip dropped: "{stripped[:70]}"')


def writing_instructions(path: Path, repo: Path | None) -> str:
    project = repo or (find_meta_json(path) or {}).get("mainRepoPath")
    entry = project_settings.entry(str(canonical_repo(project))) if project else {}
    value = entry.get("prBodyInstructions")
    if isinstance(value, str) and value.strip():
        return value.strip()
    return project_settings.DEFAULT_PR_BODY_INSTRUCTIONS


def check_default_style(lines: list[str], errors: list[str]) -> None:
    sections = headings(lines)
    titles = {title for title, _s, _e in sections}

    if not titles & set(CONTEXT_HEADINGS) and not lines[0].startswith("## "):
        errors.append("no Context (or headline) section found")
    if not titles & set(QA_HEADINGS):
        errors.append("no QA section found")

    if titles & set(CONTEXT_HEADINGS) or lines[0].startswith("## "):
        check_context(explainer_lines(lines, sections), errors)
    check_qa(section_body(lines, sections, QA_HEADINGS), errors)
    check_body_budget(lines, sections, errors)


def edited_by_user(path: Path) -> bool:
    return user_authored(path, find_run_dir(path))


def lint(path: Path, repo: Path | None) -> list[str]:
    errors: list[str] = []
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return [f"cannot read pr body: {exc}"]

    lines = text.splitlines()
    if not [line for line in lines if line.strip()]:
        return ["pr body is empty"]

    if edited_by_user(path):
        # The user wrote this body in Orc, so the agent's writing caps do not
        # apply. Raw HTML still blocks: its screenshots never reach GitHub.
        check_raw_html(text, errors)
        return errors

    if writing_instructions(path, repo) == project_settings.DEFAULT_PR_BODY_INSTRUCTIONS:
        check_default_style(lines, errors)
    check_template(text, lines, repo, errors)
    check_worktree_host(text, path, errors)
    check_deferred_findings(text, path, errors)
    check_raw_html(text, errors)
    check_hidden_notes(text, repo, errors)
    check_glued_tables(text, errors)

    if AI_FOOTER.search(text):
        errors.append("AI attribution footer present — never allowed in a PR body")
    for line in lines:
        if REVIEW_STATUS.search(line):
            errors.append(f'review status line: "{line.strip()[:70]}" — keep Orc review results out of the PR body')
            break
    for line in lines:
        if PLACEHOLDER.search(line):
            errors.append(f'placeholder text: "{line.strip()[:70]}"')
            break

    return errors


def check_raw_html(text: str, errors: list[str]) -> None:
    stripped = MARKDOWN_ANGLE_DEST.sub(r"\1()", strip_code_and_comments(text))
    found: list[str] = []
    for match in RAW_HTML_SCREENSHOT_TAG.finditer(stripped):
        tag = f"<{match.group(1).lower()}>"
        if tag not in found:
            found.append(tag)
    if found:
        tags = " and ".join(found)
        errors.append(
            f"raw HTML {tags} markup is not allowed in pr-body.md — "
            "use a Markdown pipe table (| flow | before | after |) and ![alt](path) image links"
        )


def check_hidden_notes(text: str, repo: Path | None, errors: list[str]) -> None:
    """GitHub hides an HTML comment, so a note written in one never reaches the reviewer."""
    template_path = find_template(repo) if repo is not None else None
    template = template_path.read_text(encoding="utf-8") if template_path else ""
    comments: list[str] = []
    strip_code_and_comments(text, comments)
    for comment in comments:
        if comment in template:
            continue
        inner = " ".join(comment[4:-3].split())
        errors.append(
            f'HTML comment: "{inner[:70]}" — GitHub hides it from reviewers; '
            "write the note as a visible line or delete it"
        )
        break


TABLE_DELIMITER_ROW = re.compile(r"^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$")


# The PR body editor (Crepe) reads a table right under a list item or sentence as more of that line.
def check_glued_tables(text: str, errors: list[str]) -> None:
    lines = strip_fenced_code(text).splitlines()
    for above, header, delimiter in zip(lines, lines[1:], lines[2:]):
        if (above.strip() and "|" not in above and not above.lstrip().startswith("#") and "|" in header
                and "|" in delimiter and TABLE_DELIMITER_ROW.match(delimiter)):
            errors.append(f'table "{header.strip()[:40]}" needs a blank line above it, '
                          "or it renders as plain text on the line before")


def check_ship_images(body: Path, ship: Path) -> list[str]:
    try:
        body_text = body.read_text(encoding="utf-8")
        ship_text = ship.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        return [f"cannot check Ship image coverage: {error}"]
    ship_images = {image_identity(source, ship)
                   for source in image_sources(ship_text, allow_html=True)}
    missing = sorted({source for source in image_sources(body_text, allow_html=True)
                      if image_identity(source, body) not in ship_images})
    return [f"PR image missing from Ship: {source}" for source in missing]


def check_shot_images(body: Path, manifest: Path) -> list[str]:
    try:
        entries = json.loads(manifest.read_text(encoding="utf-8"))
        if isinstance(entries, dict):
            entries = entries.get("shots")
        if not isinstance(entries, list) or not all(isinstance(entry, dict) for entry in entries):
            return ["screenshot manifest must contain an array of captures"]
        images = {image_identity(source, body)
                  for source in image_sources(body.read_text(encoding="utf-8"), allow_html=False)}
    except (OSError, UnicodeError, ValueError) as error:
        return [f"cannot check screenshot coverage: {error}"]
    problems = []
    for entry in entries:
        for side in ("before", "after"):
            source = entry.get(side)
            if isinstance(source, str) and image_identity(source, manifest) not in images:
                problems.append(f"Screenshot missing from PR body: {source}")
        # A plan's mockup shows in the run's Assets tab, never in the PR.
        source = entry.get("mockup")
        if isinstance(source, str) and image_identity(source, manifest) in images:
            problems.append(f"Mockup in PR body: {source}; it shows in the run's Assets tab")
    return problems


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Lint an Orc pr-body.md against the orc-docs caps."
    )
    parser.add_argument("pr_body", type=Path, help="path to pr-body.md")
    parser.add_argument(
        "--repo",
        type=Path,
        default=None,
        help="work repo, so the PR template's checklist and links are verified",
    )
    parser.add_argument("--ship", type=Path,
                        help="Ship source; every PR image must also be embedded there")
    parser.add_argument("--shots", type=Path, help="validated screenshot manifest to include in the result")
    parser.add_argument("--print-instructions", action="store_true",
                        help="print the writing instructions for this body before drafting it")
    args = parser.parse_args(argv)
    if args.print_instructions:
        print(writing_instructions(args.pr_body, args.repo))
        return 0

    errors = lint(args.pr_body, args.repo)
    by_user = edited_by_user(args.pr_body)
    if args.ship is not None and not by_user:
        errors.extend(check_ship_images(args.pr_body, args.ship))
    if args.shots is not None and not by_user:
        errors.extend(check_shot_images(args.pr_body, args.shots))
    if errors:
        for error in errors:
            print(f"pr-body lint: {error}")
        return 1
    print("pr-body lint: ok (your edit; writing caps skipped)" if by_user else "pr-body lint: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
