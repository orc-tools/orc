#!/usr/bin/env python3
"""Remove abandoned launcher stubs from the run store.

orc-ui precreates a run directory before the agent window opens so the run is
listed while the harness boots; the agent's hook then adopts it. A stub that is
never adopted stays a three-file shell forever, and a checkout whose tests drive
the launch path for real leaves one behind per test case.

Only a directory that is exactly that shell is removed: an empty grilling.mdx,
inputs/start-prompt.txt, meta.json still marked titlePending/running/grilling,
and a repoPath that is not a directory on this machine (a stub from a real
launch keeps a real repository path and is never touched). Files are unlinked by
name and the directories removed with rmdir, so anything unexpected inside stops
the removal rather than being swallowed.

Dry run by default; pass --apply to delete.
"""
import json
import os
import sys

RUNS = os.environ.get("ORC_RUNS_DIR") \
    or os.path.join(os.path.expanduser("~"), ".orc", "runs")
STUB = {"grilling.mdx", "inputs", "meta.json"}


def abandoned(run_dir):
    """The stub shape above, or None with a reason when it is anything else."""
    try:
        with open(os.path.join(run_dir, "meta.json")) as handle:
            meta = json.load(handle)
    except (OSError, ValueError):
        return "unreadable meta"
    if not (meta.get("titlePending") and meta.get("status") == "running"
            and meta.get("phase") == "grilling"):
        return "adopted"
    if set(os.listdir(run_dir)) != STUB:
        return "has artifacts"
    if os.listdir(os.path.join(run_dir, "inputs")) != ["start-prompt.txt"]:
        return "unexpected inputs"
    if os.path.getsize(os.path.join(run_dir, "grilling.mdx")) != 0:
        return "grilling.mdx not empty"
    if os.path.isdir(meta.get("repoPath") or ""):
        return "real repository"
    return None


def remove(run_dir):
    os.remove(os.path.join(run_dir, "inputs", "start-prompt.txt"))
    os.rmdir(os.path.join(run_dir, "inputs"))
    os.remove(os.path.join(run_dir, "grilling.mdx"))
    os.remove(os.path.join(run_dir, "meta.json"))
    os.rmdir(run_dir)


def main(argv):
    apply_ = "--apply" in argv[1:]
    for arg in argv[1:]:
        if arg != "--apply":
            sys.stderr.write("usage: orc-prune-stubs [--apply]\n")
            return 2
    if not os.path.isdir(RUNS):
        sys.stderr.write("no run store at %s\n" % RUNS)
        return 1
    found = 0
    for name in sorted(os.listdir(RUNS)):
        run_dir = os.path.join(RUNS, name)
        if name.startswith(".") or not os.path.isdir(run_dir):
            continue
        if not os.path.isfile(os.path.join(run_dir, "meta.json")):
            continue
        if abandoned(run_dir) is not None:
            continue
        found += 1
        print(name)
        if apply_:
            remove(run_dir)
    print("%d abandoned stub(s) %s" % (found, "removed" if apply_ else "found"))
    if found and not apply_:
        print("re-run with --apply to delete them")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
